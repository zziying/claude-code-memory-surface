# === Memory MCP Server ===
# Any server exposing a semantic search tool via JSON-RPC
#   Local: http://localhost:3458/<MCP_TOKEN>
#   Remote: https://your.domain/memory-mcp/<MCP_TOKEN>
MEMORY_MCP_URL=
SEARCH_TOOL_NAME=semantic_search
# Optional: a read tool that returns the full body of one memory (used to brief
# events from their full text instead of a 600-char chunk). Empty = use chunk_text.
READ_TOOL_NAME=

# If you're using the reference server.py (branch: reference-server):
MCP_TOKEN=your_random_token_here
GEMINI_API_KEY=your_gemini_api_key_here
MEMORY_DB_PATH=./memories.db
MEMORY_MCP_PORT=3458

# === LLM Reranker ===
# Any OpenAI-compatible API: DeepSeek, OpenAI, local models, etc.
# Without a key, falls back to v1 behaviour (cosine threshold only).
RERANKER_API_URL=https://api.deepseek.com/chat/completions
RERANKER_API_KEY=
RERANKER_MODEL=deepseek-v4-flash
# Reasoning models spend max_tokens on hidden thinking; keep this on for DeepSeek v4.
# Set to 0 for APIs that reject the "thinking" field.
RERANKER_DISABLE_THINKING=1

# Role names in the reranker prompt and context labels
USER_NAME=user
AI_NAME=assistant

# === Injection shape (v4) ===
# LIGHT mode injects one-line pointers (id + supporting sentence); TRIGGER injects full text.
# Set to 0 to get v3 behaviour (full text in both modes).
LIGHT_POINTER_ONLY=1
# Pointer hook = the sentence the reranker pointed at (falls back to first 50 chars)
SENT_PTR_ENABLE=1
SENT_HOOK_MAX=60
# Code-side "which progress snapshot is newest" adjudication
SNAP_ADJUDICATE=1

# === Tuning ===
TIMEOUT_SEARCH=2.0
TIMEOUT_RERANK=9.0
LIGHT_COS_GATE=0.72
EVENT_BRIEF_MAX=600
# General search lane: over-fetch, re-sort by cosine + RECENCY_W * e^(-days/RECENCY_TAU),
# cut back to 8. Only affects who enters the rerank pool.
GEN_FETCH=12
RECENCY_W=0.03
RECENCY_TAU=14
# Conversation context fed to the reranker
CONTEXT_TURNS=10
CONTEXT_TAIL_KB=300

# === Intent Gate ===
# Compound words to exclude from recall keyword matching (comma-separated)
RECALL_EXCLUDE=记忆库,记忆浮现,记忆系统,记忆hook,记忆召回
# Message prefixes to always skip (comma-separated) — headless / cron prompts
SYSTEM_PREFIXES=[auto-trigger],[system],[cron]
# Extra prefixes that arrive with the user role but are injections, excluded from
# context extraction only (comma-separated)
CONTEXT_SKIP_PREFIXES=
# Optional regex: LIGHT mode stays silent when the message matches (explicit recall
# still works). Useful for conversation modes where a memory popup is unwelcome.
MUTE_RE=

# === Log ===
HOOK_LOG_PATH=~/.claude/hooks/surface_debug.log
LOG_MAX_KB=1000
LOG_KEEP=2
