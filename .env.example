# === Memory MCP Server ===
# Any server exposing a semantic_search tool via JSON-RPC
#   Local: http://localhost:3458/<MCP_TOKEN>
#   Remote: https://your.domain/memory-mcp/<MCP_TOKEN>
MEMORY_MCP_URL=
SEARCH_TOOL_NAME=semantic_search

# If you're using the reference server.py:
MCP_TOKEN=your_random_token_here
GEMINI_API_KEY=your_gemini_api_key_here
MEMORY_DB_PATH=./memories.db
MEMORY_MCP_PORT=3458

# === LLM Reranker (v3 feature) ===
# Any OpenAI-compatible API: DeepSeek, OpenAI, local models, etc.
# Without a key, falls back to v1 behavior (cosine threshold only).
RERANKER_API_URL=https://api.deepseek.com/chat/completions
RERANKER_API_KEY=
RERANKER_MODEL=deepseek-chat

# Role names in reranker prompt (customize to your setup)
USER_NAME=user
AI_NAME=assistant

# === Tuning ===
TIMEOUT_SEARCH=2.0
TIMEOUT_RERANK=6.0
LIGHT_COS_GATE=0.65
EVENT_BRIEF_MAX=300

# === Intent Gate ===
# Compound words to exclude from recall keyword matching (comma-separated)
RECALL_EXCLUDE=记忆库,记忆浮现,记忆系统
# System message prefixes to always skip (comma-separated)
SYSTEM_PREFIXES=[auto-trigger],[system],[cron]

# === Log ===
HOOK_LOG_PATH=~/.claude/hooks/surface_debug.log
